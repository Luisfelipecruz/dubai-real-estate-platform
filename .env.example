DB_USER=dubai_user
DB_PASSWORD=dubai_pass

# ── Copilot: retrieval layer (local, no key required) ───────────────────────
#
# The embedding layer is local and fixed; only the generation layer below is
# pluggable. There is no first-party Anthropic embeddings endpoint -- Claude is a
# generation model -- so vectors come from a sentence-transformers service running
# in-cluster.
#
# EMBEDDING_MODEL is written into every row of doc_chunks and asserted at query time.
# Changing it invalidates every stored vector: re-index with `make reindex`, or
# /search returns 503 rather than comparing two incomparable vector spaces.
EMBEDDINGS_URL=http://embeddings:8100
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

RETRIEVAL_TOP_K=20    # candidates pulled from EACH arm before fusion
RERANK_TOP_N=5        # results returned after the cross-encoder
RRF_K=60              # Reciprocal Rank Fusion constant, Cormack et al. (2009)

# ── Copilot: generation layer (m14) ─────────────────────────────────────────
#
# local     -> Ollama. Defaults to the one running on the HOST, not a container.
# anthropic -> the Claude API, needs ANTHROPIC_API_KEY
# none      -> generation disabled. /search still works, and so do the 27 core
#              operations. This is a supported configuration, not a broken one.
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# host.docker.internal, deliberately. Docker Desktop on macOS cannot pass the Apple GPU
# into a Linux container, so `docker compose --profile llm up ollama` gets you the same
# model running on CPU -- several times slower for no benefit. The host's Ollama uses
# Metal. Switch to http://ollama:11434 on a Linux host with a GPU, or in CI where a
# self-contained stack matters more than throughput.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Which local model is an m16 measurement, not a preference. The default is what tool
# calling actually needs: native function-calling support, not just fluent text.
#   gpt-oss:20b      13 GB, native tool calling            <- default
#   qwen3-coder:30b  18 GB, strong structured output
#   deepseek-r1:8b   reasoning traces, weak tool calling -- expect it to lose
OLLAMA_MODEL=gpt-oss:20b

# ── Budgets (m14/m15) ───────────────────────────────────────────────────────
#
# Ceilings, not targets. A retrieval bug that returns 200 chunks instead of 5 shows up
# here as a refused request rather than as a bill.
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_COST_USD_PER_REQUEST=0.50
AGENT_MAX_STEPS=8

# ── Voice (m17) ─────────────────────────────────────────────────────────────
VOICE_URL=http://voice:8200
WHISPER_MODEL=base.en
